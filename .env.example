# Copy to .env and fill in real values. Never commit .env.

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=virgool

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

#Secrets
COOKIE_SECRET=
OTP_TOKEN_SECRET=
ACCESS_TOKEN_SECRET=
EMAIL_TOKEN_SECRET=
PHONE_TOKEN_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_SECRET_ID=

# --- OTP delivery (R-01) -----------------------------------------------------
# SMTP transport is used for email OTPs whenever SMTP_HOST is set.
# Outside production, with SMTP_HOST unset, codes are printed to the backend
# console instead (dev console transport).
# In production (NODE_ENV=production) BOTH must hold, otherwise OTP delivery
# fails safely with a 500 and no code is exposed anywhere:
#   - email OTPs: SMTP_HOST (and SMTP_USER/SMTP_PASS) configured
#   - phone OTPs: an SMS provider must be wired in OtpDeliveryService first
# Run the API with NODE_ENV=production in production (start:prod).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Global rate limiting (R-04) ---------------------------------------------
# Sliding-window cap applied to EVERY HTTP route, per client IP, by the
# NestJS throttler (in-memory store, single-instance). The OTP flow keeps its
# own separate DB-backed limits (3 requests / 10 minutes) on top of this.
# Defaults (used when unset / invalid): 100 requests per 60000 ms.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# --- Auth sessions (R-05) -----------------------------------------------------
# Short-lived access JWT + rotating opaque refresh token in an HttpOnly cookie
# (refresh_token, SameSite=Lax, Path=/api/auth). The DB stores only a SHA-256
# hash of the refresh token; reuse of a rotated token revokes its whole family.
#
# ACCESS_TOKEN_TTL   access-token lifetime, any jsonwebtoken duration string
#                    (default when unset: 15m).
# REFRESH_TOKEN_TTL_DAYS  refresh cookie + session lifetime in days (default 30).
# FRONTEND_ORIGIN    comma-separated origins allowed to call the cookie
#                    endpoints (POST /auth/refresh, /auth/logout,
#                    /auth/google/exchange) and base URL of the OAuth redirect.
#                    Defaults (unset): localhost:3000/3001 for development.
#
# Production checklist:
#   - Run with NODE_ENV=production so the refresh cookie gets the Secure flag.
#   - ROTATE ACCESS_TOKEN_SECRET when deploying this model: old 1-year tokens
#     must be invalidated immediately. Generate a fresh random value and keep
#     it in the environment only — never commit it.
#   - Set FRONTEND_ORIGIN to the real https:// site origin.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
FRONTEND_ORIGIN=http://localhost:3001
